amends "workbench:plan"

meta {
  title = "Nerd Guide initial-slice review and delivery"
  goal = "Review the accepted floating guide with four weak-area perspectives, apply reasonable initial-slice fixes, verify and reload the canonical plugin, then commit and push scoped community source. Later catalog/motion/performance increments remain in the original plan."
}

local review = new Guard {
  id = "four-perspective-review"
  owner = "Execution Steward"
  outcome = "Consume the byte-verified four-lens implementation review and adjudicate concrete defects against the requested initial slice."
  observes { "plugins/plugin-guide-for-nerds/**"; "verified Perspectives artifact thr_78yx43nd8t" }
  oracle = module.adjudicated("Retain the verified artifact receipt, coverage, disagreements and limits. Record reasonable fixes, deferred roadmap findings and reasoned disagreements with source evidence.", "Execution Steward")
}
local fixes = new Action {
  id = "review-fixes"
  owner = "Execution Steward"
  outcome = "Apply bounded accepted fixes with meaningful regression checks and concise evidence; preserve complete donor content and native plugin mounting."
  grant { "plugins/plugin-guide-for-nerds/**"; "plans/bb-plugin-guide-for-nerds/evidence/review/**"; "package-lock.json" }
  needs { module.verified(review) }
  oracle = module.adjudicated("Accepted defects have a concrete corrected witness; relevant tests/typechecks/build and generation closure pass. Full community install/test/typecheck/build checks pass after final changes. No fork changes or unrelated authored changes included.", "Execution Steward")
}
local delivery = new Action {
  id = "reload-commit-push"
  owner = "Execution Steward"
  outcome = "Reload the verified lazy build from its canonical plugin path, exercise visible footer/open/close behavior, and commit/push the scoped community change."
  grant { "plugins/plugin-guide-for-nerds/**"; "plans/bb-plugin-guide-for-nerds*"; "README.md"; ".github/workflows/publish.yml"; "package-lock.json" }
  needs { module.produced(fixes); module.verified(fixes) }
  oracle = module.adjudicated("Native browser observes the final generation and one visible floating guide from the footer. Git staged diff contains only authorized source/metadata and concise records, excluding generated dist, research downloads and secrets. Commit is pushed normally to the selected community branch; record commit identity and remaining limits. Preserve unrelated workspace/child edits.", "Execution Steward")
}
nodes { review; fixes; delivery }
