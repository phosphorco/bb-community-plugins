{
  "name": "@phosphorco/bb-jev",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "description": "Bounded shared JEV transport operations for independently installed BB plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-jev"
  },
  "exports": {
    ".": {
      "types": "./dist/types/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "bun": "1.3.14",
    "typescript": "5.9.3",
    "@get-bb/plugin-sdk": "https://github.com/phosphorco/bb-fork/releases/download/sdk-0.6.143-phosphor.05199007.upgrade1/get-bb-plugin-sdk-0.6.143+phosphor.05199007.upgrade1.tgz"
  },
  "scripts": {
    "build": "bun tools/build.mjs && tsc -p tsconfig.declarations.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:packed-consumer": "node tools/packed-consumer.mjs"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": ">=0.6.52 <0.7.0"
  },
  "peerDependenciesMeta": {
    "@get-bb/plugin-sdk": {
      "optional": true
    }
  }
}
