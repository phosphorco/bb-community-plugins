{
  "name": "@phosphorco/bb-context-recognition",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "description": "Bounded contextual recognition and hosted supplier presentations.",
  "author": "Phosphor",
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/packages/bb-context-recognition#readme",
  "bugs": {
    "url": "https://github.com/phosphorco/bb-community-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-context-recognition"
  },
  "keywords": [
    "bb",
    "recognition",
    "references",
    "plugin-contract"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./presentation": {
      "types": "./dist/types/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing/react": {
      "types": "./dist/types/testing-react.d.ts",
      "import": "./dist/testing-react.js"
    }
  },
  "files": [
    "dist/",
    "fixtures/",
    "README.md",
    "CONTRACT.md",
    "PACKAGING.md",
    "LICENSE",
    "design/presentation-registry.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": "^0.5.29 || ^0.6.29",
    "react": "^19",
    "react-dom": "^19",
    "jsdom": "^27.0.0"
  },
  "peerDependenciesMeta": {
    "@get-bb/plugin-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "bun": "1.3.14",
    "typescript": "^5.9.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "jsdom": "^27.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/jsdom": "^27.0.0"
  },
  "scripts": {
    "build": "bun tools/build.mjs --entry src/index.ts --target browser --entry src/bb.ts --target browser --entry src/presentation.ts --target browser --entry src/react.tsx --target browser --entry src/testing.ts --target browser --entry src/testing-react.tsx --target browser --external zod --external react --external react/* --external react-dom --external react-dom/* --external jsdom --external @get-bb/plugin-sdk --external @get-bb/plugin-sdk/* --external node:* && tsc --project tsconfig.declarations.json",
    "test": "node tools/ordinary-test.mjs",
    "typecheck": "tsc --noEmit",
    "benchmark:discovery": "node tools/benchmark-discovery.mjs",
    "test:packed-consumer": "node tools/packed-consumer.mjs"
  }
}
