{
  "name": "@phosphorco/bb-people-accounts",
  "version": "0.2.0-dev.0",
  "type": "module",
  "license": "MIT",
  "description": "Portable identity associations and contribution contracts, with legacy People Accounts v1 compatibility.",
  "author": "Phosphor",
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/packages/bb-people-accounts#readme",
  "bugs": {
    "url": "https://github.com/phosphorco/bb-community-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-people-accounts"
  },
  "keywords": [
    "bb",
    "attribution",
    "people-accounts"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./v2": {
      "types": "./dist/types/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./v2/bb": {
      "types": "./dist/types/v2-bb.d.ts",
      "import": "./dist/v2-bb.js"
    },
    "./v2/testing": {
      "types": "./dist/types/v2-testing.d.ts",
      "import": "./dist/v2-testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "LICENSE",
    "V2-CONTRACT.md",
    "COMPATIBILITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@phosphorco/bb-identity": "0.5.0"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": ">=0.5.29 <0.6 || ^0.6.29"
  },
  "peerDependenciesMeta": {
    "@get-bb/plugin-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.52",
    "@types/bun": "1.3.14",
    "bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bun tools/build.mjs --entry \"src/index.ts\" --target browser --entry \"src/bb.ts\" --target browser --entry \"src/testing.ts\" --target browser --entry \"src/v2.ts\" --target browser --entry \"src/v2-bb.ts\" --target browser --entry \"src/v2-testing.ts\" --target browser --external \"zod\" --external \"@phosphorco/bb-identity/*\" --external \"@get-bb/plugin-sdk\" --external \"@get-bb/plugin-sdk/*\" && tsc --project tsconfig.declarations.json",
    "test": "bun run build && bun test test",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.types.json --noEmit"
  }
}
