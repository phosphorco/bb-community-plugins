{
  "name": "@phosphorco/bb-provider-settings",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Explicit owner-bound provider role settings.",
  "author": "Phosphor",
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/packages/bb-provider-settings#readme",
  "bugs": {
    "url": "https://github.com/phosphorco/bb-community-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-provider-settings"
  },
  "keywords": [
    "bb",
    "provider",
    "settings"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./testing/react": {
      "types": "./dist/types/testing-react.d.ts",
      "import": "./dist/testing-react.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": ">=0.5.29 <0.6 || ^0.6.29",
    "jsdom": "^27.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "@get-bb/plugin-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "bun": "1.3.14",
    "jsdom": "^27.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "bun tools/build.mjs --entry \"src/index.ts\" --target browser --entry \"src/bb.ts\" --target browser --entry \"src/react.tsx\" --target browser --entry \"src/testing.ts\" --target browser --entry \"src/testing-react.tsx\" --target browser --external \"zod\" --external \"react\" --external \"react/*\" --external \"react-dom\" --external \"react-dom/*\" --external \"jsdom\" --external \"@get-bb/plugin-sdk\" --external \"@get-bb/plugin-sdk/*\" && tsc --project tsconfig.declarations.json",
    "test": "node tools/ordinary-test.mjs",
    "typecheck": "tsc --noEmit"
  }
}
