{
  "name": "@phosphorco/bb-thread-attachments",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Versioned shared thread attachment facts and atomic family operations for independent BB presentations.",
  "author": "Phosphor",
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/packages/bb-thread-attachments#readme",
  "bugs": {
    "url": "https://github.com/phosphorco/bb-community-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-thread-attachments"
  },
  "keywords": [
    "bb",
    "threads",
    "attachments",
    "plugin-contract"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": "^0.6.31"
  },
  "peerDependenciesMeta": {
    "@get-bb/plugin-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "https://github.com/phosphorco/bb-fork/releases/download/sdk-0.6.143-phosphor.05199007.upgrade1/get-bb-plugin-sdk-0.6.143+phosphor.05199007.upgrade1.tgz",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "bun": "1.3.14",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "bun tools/build.mjs --entry \"src/index.ts\" --target browser --entry \"src/bb.ts\" --target browser --entry \"src/testing.ts\" --target browser --external \"zod\" --external \"@get-bb/plugin-sdk\" --external \"@get-bb/plugin-sdk/*\" && tsc --project tsconfig.declarations.json",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit"
  }
}
