{
  "name": "@phosphorco/bb-markdown",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Source-framed read-only internal Markdown with bounded progressive recognition.",
  "author": "Phosphor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "packages/bb-markdown"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing/source-gate": {
      "types": "./dist/types/source-gate.d.ts",
      "import": "./dist/testing-source-gate.js"
    },
    "./bb": {
      "types": "./dist/types/bb.d.ts",
      "import": "./dist/bb.js"
    }
  },
  "files": [
    "dist/",
    "tools/check-sources.mjs",
    "tools/markdown-debt.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@phosphorco/bb-context-recognition": "0.4.1",
    "@tanstack/store": "0.11.1",
    "@tanstack/react-store": "0.11.1",
    "zod": "4.6.7",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "remark-rehype": "11.1.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-math": "6.0.0"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": "^0.6.52",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@get-bb/plugin-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.52",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "bun": "1.3.14",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/jsdom": "^27.0.0",
    "jsdom": "^27.0.0"
  },
  "scripts": {
    "build": "bun tools/build.mjs && tsc -p tsconfig.declarations.json",
    "test": "node --test test/core.test.mjs test/server.test.mjs test/react.test.mjs test/source-gate.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:sources": "node tools/check-sources.mjs",
    "check:freshness": "bun tools/check-library.mjs",
    "test:native-host": "node tools/check-native.mjs",
    "test:source-loader": "bun tools/check-source-loader.mts",
    "verify:pilots": "npm run check:freshness && npm run test:freshness && npm run test:native-host && npm run test:source-loader",
    "test:packed-consumer": "node tools/packed-consumer.mjs",
    "test:freshness": "bun test test/freshness.test.mjs"
  }
}
