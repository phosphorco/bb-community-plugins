{
  "name": "@phosphorco/bb-plugin-compact-display",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Responsive thread widths and compact prompt editor height and spacing.",
  "author": "Phosphor",
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/plugins/compact-display#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "plugins/compact-display"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "compact",
    "appearance",
    "composer"
  ],
  "engines": {
    "bb": ">=0.46.1 <1.0.0",
    "bbPluginSdk": ">=0.6.52"
  },
  "bb": {
    "name": "Compact display",
    "description": "Adapt thread columns to 760, 1080, or 1440px and reduce prompt editor height and spacing. To retire the wide layout, select Default in Appearance and disable this plugin.",
    "branding": {
      "icon": "Minimize2"
    },
    "server": "./server.ts",
    "app": "./app.ts",
    "skills": [],
    "themes": [
      {
        "id": "wide-default",
        "name": "Default + wide thread columns",
        "description": "Default palette with pane-responsive 760/1080/1440px columns. Native appearance caches these rules before app rendering on returning clients.",
        "css": "./thread-width.css"
      }
    ]
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "server.ts",
    "app.ts",
    "thread-width.css"
  ],
  "dependencies": {},
  "devDependencies": {
    "@get-bb/plugin-sdk": "https://github.com/phosphorco/bb-fork/releases/download/sdk-0.6.143-phosphor.05199007.upgrade1/get-bb-plugin-sdk-0.6.143+phosphor.05199007.upgrade1.tgz",
    "@types/react": "19.2.2",
    "react": "19.2.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node ../../tools/bb-target-cli.mjs plugin build .",
    "dev": "node ../../tools/bb-target-cli.mjs plugin dev .",
    "typecheck": "tsc --noEmit"
  }
}
