{
  "name": "@phosphorco/bb-plugin-plugin-guide-for-nerds",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Phosphor",
  "description": "A floating companion to the complete BB Plugin Guide.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "plugins/plugin-guide-for-nerds"
  },
  "homepage": "https://github.com/phosphorco/bb-community-plugins/tree/main/plugins/plugin-guide-for-nerds#readme",
  "bugs": {
    "url": "https://github.com/phosphorco/bb-community-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "plugin-guide"
  ],
  "engines": {
    "bb": ">=0.44.0",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "BB Plugin Guide for Nerds",
    "description": "Open the complete Plugin Guide above your current BB page.",
    "branding": {
      "icon": "./icons/ai-generative.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/",
    "app.tsx",
    "app.css",
    "server.ts",
    "src/",
    "components/",
    "lib/",
    "icons/",
    "scripts/",
    "tsconfig*.json",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "notices/"
  ],
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.4",
    "@hugeicons/react": "1.1.6",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "5.9.3",
    "vitest": "4.1.1",
    "jsdom": "29.0.1",
    "bb-app-build-044": "npm:bb-app@0.44.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lazy": "node scripts/build.mjs --lazy",
    "typecheck": "tsc --noEmit",
    "typecheck:content": "tsc --noEmit -p tsconfig.content.json",
    "typecheck:overlay": "tsc --noEmit -p tsconfig.overlay.json",
    "test": "vitest run --config vitest.config.ts",
    "test:fork": "vitest run --config vitest.config.ts --exclude app.test.tsx --exclude test/plugin-app-layout.test.ts --exclude test/overlay*.test.* --exclude test/first-slice*.test.*",
    "test:overlay": "vitest run --config vitest.config.ts test/overlay",
    "test:first-slice": "vitest run --config vitest.config.ts app.test.tsx test/plugin-app-layout.test.ts test/first-slice",
    "scaffold:surface-entry": "node scripts/scaffold-surface-entry.mjs",
    "check:lazy-build": "node scripts/check-lazy-build.mjs",
    "test:navigation": "vitest run --config vitest.config.ts test/navigation.test.tsx test/annotation-scope.test.ts test/mobile-guide.test.ts"
  }
}
