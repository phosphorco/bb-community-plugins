{
  "name": "@phosphorco/bb-plugin-sentry",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Direct Sentry MCP access with shared OAuth settings and native agent tools.",
  "author": "Phosphor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phosphorco/bb-community-plugins.git",
    "directory": "plugins/sentry"
  },
  "engines": {
    "bb": ">=0.46.1 <1.0.0",
    "bbPluginSdk": ">=0.6.52"
  },
  "bb": {
    "name": "Sentry",
    "description": "Use official Sentry tools with one shared sign-in.",
    "branding": {
      "icon": "Bug"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/sentry"
    ]
  },
  "files": [
    "dist/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "skills/",
    "*.ts",
    "*.tsx",
    "*.css",
    "mcp/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.52",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.0",
    "better-sqlite3": "^12.0.0"
  },
  "scripts": {
    "build": "\"${BB_CLI:-bb}\" plugin build .",
    "test": "node --test --experimental-strip-types test/*.test.ts && vitest run test/*.test.tsx",
    "typecheck": "tsc --noEmit"
  }
}
